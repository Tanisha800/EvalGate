# Copy to .env for LOCAL development:  cp .env.example .env
# These are local-only values for containers bound to 127.0.0.1.
# Change them if you like; never reuse them anywhere real.
# Further variables (GitHub App, session secrets, ...) are added in the phase that needs them.

POSTGRES_USER=evalgate
POSTGRES_PASSWORD=evalgate_local_dev
POSTGRES_DB=evalgate
POSTGRES_PORT=5432

REDIS_PORT=6379

DATABASE_URL=postgresql://evalgate:evalgate_local_dev@127.0.0.1:5432/evalgate
REDIS_URL=redis://127.0.0.1:6379
